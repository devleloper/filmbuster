# Filmbuster client configuration (compile-time only).
#
# The app does not read this file at runtime and it is not bundled as an
# asset. Values are baked in at build time through --dart-define:
#
#   cp .env.example .env            # local copy, ignored by git
#   flutter run --dart-define-from-file=.env
#
# or pass a single value without any file:
#
#   flutter run --dart-define=API_BASE_URL=http://192.0.2.10:8080
#
# Without either, or with an empty API_BASE_URL, the client runs in demo
# mode: the bundled open-movie catalogue, no backend and no key.
#
# Never put secrets here: every --dart-define value is readable in the
# compiled app.

# Base URL of a Filmbuster backend (live mode). The Go backend listens on
# port 8080 by default. Leave empty for demo mode.
API_BASE_URL=http://localhost:8080
